rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active(){ return signedIn() && me().data.get('status', 'active') == 'active'; }
    function role(r){ return active() && me().data.role == r; }
    function admin(){ return role('admin'); }
    function myCompany(){ return get(/databases/$(database)/documents/companies/$(request.auth.uid)); }
    function myCompanyVerified(){ return myCompany().data.get('verified', false); }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['candidate','employer']
                    && request.resource.data.get('status','active') == 'active';
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if admin() || (active() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.get('status','active') == resource.data.get('status','active'));
      allow delete: if admin();
      match /savedJobs/{id} {
        allow read, write: if active() && request.auth.uid == uid;
      }
    }

    match /jobs/{id} {
      allow read: if resource.data.status == 'published'
                  || (active() && (resource.data.employerId == request.auth.uid || admin()));
      allow create: if admin() || (role('employer')
                    && request.resource.data.employerId == request.auth.uid
                    && request.resource.data.status in ['pending','draft']
                    && request.resource.data.companyVerified == myCompanyVerified());
      allow update: if admin()
                    || (role('employer')
                        && resource.data.employerId == request.auth.uid
                        && request.resource.data.employerId == resource.data.employerId
                        && request.resource.data.companyVerified == resource.data.companyVerified
                        && (
                          (resource.data.status == 'draft' && request.resource.data.status in ['draft','pending','closed']) ||
                          (resource.data.status == 'pending' && request.resource.data.status in ['pending','closed']) ||
                          (resource.data.status == 'rejected' && request.resource.data.status in ['pending','closed']) ||
                          (resource.data.status == 'published' && request.resource.data.status in ['paused','closed']) ||
                          (resource.data.status == 'paused' && request.resource.data.status in ['pending','closed']) ||
                          (resource.data.status == 'closed' && request.resource.data.status == 'pending')
                        ));
      allow delete: if admin();
    }

    match /applications/{id} {
      allow create: if role('candidate')
                    && request.resource.data.candidateId == request.auth.uid
                    && id == request.resource.data.jobId + '_' + request.auth.uid
                    && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'published';
      allow read: if active() && (resource.data.candidateId == request.auth.uid
                  || resource.data.companyId == request.auth.uid || admin());
      allow update: if admin()
                    || (role('employer') && resource.data.companyId == request.auth.uid)
                    || (role('candidate')
                        && resource.data.candidateId == request.auth.uid
                        && request.resource.data.candidateId == resource.data.candidateId
                        && request.resource.data.jobId == resource.data.jobId
                        && request.resource.data.companyId == resource.data.companyId
                        && request.resource.data.status == 'submitted');
      allow delete: if admin();
    }

    match /companies/{id} {
      allow read: if resource.data.get('verified', false) == true || (active() && (id == request.auth.uid || admin()));
      allow create: if role('employer') && id == request.auth.uid
                    && request.resource.data.get('verified', false) == false;
      allow update: if admin() || (role('employer') && id == request.auth.uid
                    && request.resource.data.get('verified', false) == resource.data.get('verified', false));
      allow delete: if admin();
    }

    match /candidateProfiles/{uid} {
      allow read: if active() && (request.auth.uid == uid || admin()
                  || (role('employer') && resource.data.searchable == true));
      allow create, update: if role('candidate') && request.auth.uid == uid;
      allow delete: if admin() || (active() && request.auth.uid == uid);
    }

    match /reports/{id} {
      allow create: if active() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
