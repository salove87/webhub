rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
  match /resumes/{uid}/{file}{ allow read,write: if request.auth!=null && request.auth.uid==uid && request.resource.size<5*1024*1024 && request.resource.contentType=='application/pdf'; }
  match /company-documents/{uid}/{file}{ allow read,write: if request.auth!=null && request.auth.uid==uid && request.resource.size<10*1024*1024; }
  match /public/{allPaths=**}{ allow read: if true; allow write: if request.auth!=null && request.resource.size<5*1024*1024 && request.resource.contentType.matches('image/.*'); }
} }
