rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    match /articles/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /resumes/{candidateId}/{applicationId}/{file} {
      allow create, update: if request.auth != null
        && request.auth.uid == candidateId
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
      allow read: if request.auth != null && (
        request.auth.uid == candidateId
        || isAdmin()
        || firestore.get(
          /databases/(default)/documents/applications/$(applicationId)
        ).data.companyId == request.auth.uid
      );
      allow delete: if request.auth != null && (request.auth.uid == candidateId || isAdmin());
    }

    match /company-documents/{uid}/{file} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
